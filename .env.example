# ────────────────────────────────────────────────
# MYEVIEW Environment Variables
# Copy this to .env and fill in production values
# ────────────────────────────────────────────────

# ── Database ──
DB_HOST=postgres
DB_PORT=5432
DB_USER=myeview
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=myeview
DB_SSL_MODE=disable

# ── JWT ──
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── NATS ──
NATS_URL=nats://nats:4222

# ── MinIO / S3 ──
MINIO_USER=myeview_admin
MINIO_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# ── CORS — set to your actual domain in production ──
CORS_ORIGIN=https://yourdomain.com

# ── API Keys ──
# OpenAI: Required for Compliance RAG (gap analysis fallback)
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Censys: Required for Advanced Scan mode (asset discovery)
# Get at: https://search.censys.io/account/api
CENSYS_API_ID=censys_NTmvNPQq
CENSYS_SECRET=MZ5mXJWk2DExR4xoakFBUfdY

# Shodan: Optional, enhances Advanced Scan
# Get at: https://account.shodan.io
SHODAN_API_KEY=

# ── Frontend ──
VITE_API_URL=/api/v1
